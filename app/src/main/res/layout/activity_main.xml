<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="80sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сервис остановлен"
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#888888"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/buttonTimer"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="startTimer"
        android:text="Запустить таймер" />

    <Button
        android:id="@+id/buttonStopwatch"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="startStopwatch"
        android:text="Запустить секундомер" />

    <Button
        android:id="@+id/buttonStop"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="stopServiceClick"
        android:text="Остановить" />
</LinearLayout>